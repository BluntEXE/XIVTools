<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XivToolsUI.ViewModels"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="XivToolsUI.Views.ModpackView"
             x:DataType="vm:ModpackViewModel"
             Background="{StaticResource BgBase}">
  <Grid RowDefinitions="Auto,*">

    <!-- Page header -->
    <Border Grid.Row="0" Padding="24,20,24,16"
            BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="2">
        <TextBlock Text="Modpack Operations" FontSize="17" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}"/>
        <TextBlock Text="Create, upgrade, and convert modpacks"
                   FontSize="10" Foreground="{StaticResource TextMuted}"/>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="24" Spacing="20" MaxWidth="720">

        <!-- Upgrade to Dawntrail (batch) -->
        <Border Classes="card">
          <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <material:MaterialIcon Kind="ArrowUpCircle" Width="16" Height="16"
                                     Foreground="{StaticResource AccentBlue}"/>
              <TextBlock Text="Upgrade to Dawntrail" FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimary}" FontSize="13"/>
            </StackPanel>
            <TextBlock Text="Select any number of .ttmp2/.ttmp/.pmp files. Upgraded copies are saved alongside the originals with a &quot;_DT&quot; suffix."
                       FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>

            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock Grid.Column="0" VerticalAlignment="Center"
                         Text="{Binding UpgradeQueue.Count, StringFormat='{}{0} file(s) queued'}"
                         FontSize="12" Foreground="{StaticResource TextSecondary}"/>
              <Button Grid.Column="1" Classes="btn" Margin="8,0,0,0"
                      Command="{Binding ClearUpgradeQueueCommand}" Content="Clear"/>
              <Button Grid.Column="2" Classes="btn" Margin="8,0,0,0"
                      Command="{Binding BrowseUpgradeFilesCommand}" Content="Add Files..."/>
            </Grid>

            <ItemsControl ItemsSource="{Binding UpgradeQueue}" MaxHeight="200">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                               FontSize="12" Foreground="{StaticResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding Status}" Margin="12,0,0,0"
                               FontSize="11" Foreground="{StaticResource TextMuted}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Classes="btn-primary" HorizontalAlignment="Left"
                    Command="{Binding UpgradeAllCommand}" IsEnabled="{Binding !IsUpgrading}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <material:MaterialIcon Kind="ArrowUpCircle" Width="16" Height="16"/>
                <TextBlock Text="Upgrade All" FontWeight="SemiBold"/>
              </StackPanel>
            </Button>

            <ProgressBar IsIndeterminate="{Binding IsUpgrading}" IsVisible="{Binding IsUpgrading}"
                         Height="3" CornerRadius="2"/>
          </StackPanel>
        </Border>

        <!-- Log -->
        <Border Classes="card" Padding="0">
          <StackPanel>
            <Border Padding="16,10" BorderBrush="{StaticResource BorderDefault}"
                    BorderThickness="0,0,0,1">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <material:MaterialIcon Kind="Console" Width="14" Height="14"
                                       Foreground="{StaticResource TextMuted}"/>
                <TextBlock Text="Output Log" FontSize="12" FontWeight="Medium"
                           Foreground="{StaticResource TextSecondary}"/>
              </StackPanel>
            </Border>
            <SelectableTextBlock Margin="16" Text="{Binding OperationLog}"
                        Foreground="{StaticResource TextSecondary}"
                        FontFamily="Monospace" FontSize="12"
                        TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- Divider -->
        <Border Height="1" Background="{StaticResource BorderDefault}" Margin="0,8"/>

        <!-- Convert Format -->
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <material:MaterialIcon Kind="Refresh" Width="16" Height="16"
                                   Foreground="{StaticResource AccentGreen}"/>
            <TextBlock Text="Convert Format" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"/>
          </StackPanel>
          <TextBlock Text="Convert a single modpack between .ttmp2 and .pmp."
                     FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Classes="card">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Classes="field"
                       Text="{Binding InputPath}"
                       PlaceholderText="Select source modpack..."/>
              <Button Grid.Column="1" Classes="btn" Margin="8,0,0,0"
                      Command="{Binding BrowseInputCommand}" Content="Browse"/>
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Classes="field"
                       Text="{Binding OutputPath}"
                       PlaceholderText="Output path..."/>
              <Button Grid.Column="1" Classes="btn" Margin="8,0,0,0"
                      Command="{Binding BrowseOutputCommand}" Content="Browse"/>
            </Grid>
            <Button Classes="btn" HorizontalAlignment="Left"
                    Command="{Binding ResaveCommand}" IsEnabled="{Binding !IsBusy}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <material:MaterialIcon Kind="Refresh" Width="16" Height="16"/>
                <TextBlock Text="Convert" FontWeight="SemiBold"/>
              </StackPanel>
            </Button>
            <ProgressBar IsIndeterminate="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                         Height="3" CornerRadius="2"/>
          </StackPanel>
        </Border>

        <!-- Divider -->
        <Border Height="1" Background="{StaticResource BorderDefault}" Margin="0,8"/>

        <!-- ── Create Modpack ─────────────────────────────────────── -->
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <material:MaterialIcon Kind="PackageVariantClosed" Width="16" Height="16"
                                   Foreground="{StaticResource AccentPrimary}"/>
            <TextBlock Text="Create Modpack" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}"/>
          </StackPanel>
          <TextBlock Text="Package a mod folder into a distributable .pmp file. Auto-reads metadata from Penumbra's meta.json."
                     FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Source folder -->
        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Text="Mod Folder" FontWeight="Medium" FontSize="13"
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                       Text="Select a Penumbra mod folder (contains meta.json) or any folder with game files organised by game path (chara/, ui/, bgcommon/, etc.)."/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Classes="field"
                       Text="{Binding SourceFolder}"
                       PlaceholderText="Select mod folder..."/>
              <Button Grid.Column="1" Classes="btn" Margin="8,0,0,0"
                      Command="{Binding BrowseSourceFolderCommand}" Content="Browse"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Metadata -->
        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Text="Modpack Metadata" FontWeight="Medium" FontSize="13"
                       Foreground="{StaticResource TextPrimary}"/>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
              <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                <TextBlock Text="Name" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                <TextBox Classes="field" Text="{Binding PackName}" PlaceholderText="Mod name"/>
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                <TextBlock Text="Author" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                <TextBox Classes="field" Text="{Binding PackAuthor}" PlaceholderText="Your name"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                <TextBlock Text="Version" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                <TextBox Classes="field" Text="{Binding PackVersion}" PlaceholderText="1.0.0"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                <TextBlock Text="Description" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                <TextBox Classes="field" Text="{Binding PackDesc}" PlaceholderText="Optional description"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Output + Create -->
        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Text="Output File" FontWeight="Medium" FontSize="13"
                       Foreground="{StaticResource TextPrimary}"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Classes="field"
                       Text="{Binding CreateOutput}"
                       PlaceholderText="Output .pmp path..."/>
              <Button Grid.Column="1" Classes="btn" Margin="8,0,0,0"
                      Command="{Binding BrowseCreateOutputCommand}" Content="Browse"/>
            </Grid>
          </StackPanel>
        </Border>

        <Button Classes="btn-primary" HorizontalAlignment="Left"
                Command="{Binding CreateModpackCommand}"
                IsEnabled="{Binding !IsCreating}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <material:MaterialIcon Kind="PackageVariantClosedPlus" Width="16" Height="16"/>
            <TextBlock Text="Create .pmp" FontWeight="SemiBold"/>
          </StackPanel>
        </Button>

        <ProgressBar IsIndeterminate="{Binding IsCreating}" IsVisible="{Binding IsCreating}"
                     Height="3" CornerRadius="2"/>

        <!-- Create log -->
        <Border Classes="card" Padding="0"
                IsVisible="{Binding CreateLog, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <SelectableTextBlock Margin="16,12"
                      Text="{Binding CreateLog}"
                      Foreground="{StaticResource TextSecondary}"
                      FontFamily="Monospace" FontSize="12"
                      TextWrapping="Wrap"/>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
