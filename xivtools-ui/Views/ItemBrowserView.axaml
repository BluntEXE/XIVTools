<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XivToolsUI.ViewModels"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="XivToolsUI.Views.ItemBrowserView"
             x:DataType="vm:ItemBrowserViewModel"
             Background="{StaticResource BgBase}">
  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Header — matches sidebar height, title + back button only -->
    <Border Grid.Row="0" Padding="24,20,24,16"
            BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="Item Browser" FontSize="17" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimary}"/>
          <TextBlock Text="{Binding StatusMsg}" FontSize="10"
                     Foreground="{StaticResource TextMuted}"/>
        </StackPanel>
        <Button Grid.Column="1" Classes="btn"
                Command="{Binding BackToResultsCommand}"
                IsVisible="{Binding !ShowResults}"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <material:MaterialIcon Kind="ArrowLeft" Width="14" Height="14"/>
            <TextBlock Text="Back to Results"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Search bar — own row, same pattern as File Search -->
    <Border Grid.Row="1" Padding="24,12"
            BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,16,*,Auto">
        <TextBox Grid.Column="0" Classes="field"
                 Text="{Binding NameQuery}"
                 PlaceholderText="Search by name (e.g. hempen camise, hair 184)..."
                 KeyDown="OnNameKeyDown"/>
        <Button Grid.Column="1" Classes="btn-primary" Margin="8,0,0,0"
                Content="Search" Command="{Binding SearchByNameCommand}"
                IsEnabled="{Binding !IsBusy}"/>
        <Border Grid.Column="2" Width="1" Background="{StaticResource BorderSubtle}"/>
        <TextBox Grid.Column="3" Classes="field" Margin="8,0,0,0"
                 Text="{Binding RootQuery}"
                 PlaceholderText="Root ID (e.g. c0201h0184, c0201e6071_top)..."
                 KeyDown="OnRootKeyDown"/>
        <Button Grid.Column="4" Classes="btn" Margin="8,0,0,0"
                Content="Look Up" Command="{Binding LookupRootCommand}"
                IsEnabled="{Binding !IsBusy}"/>
      </Grid>
    </Border>

    <!-- Content: search results OR file list -->
    <Grid Grid.Row="2">

      <!-- ── Search results ── -->
      <Grid IsVisible="{Binding ShowResults}" RowDefinitions="*">
        <DataGrid ItemsSource="{Binding SearchResults}"
                  SelectedItem="{Binding SelectedResult}"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  CanUserResizeColumns="True"
                  Background="{StaticResource BgBase}"
                  RowBackground="{StaticResource BgBase}"
                  BorderThickness="0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name"     Binding="{Binding Name}"     Width="2*" FontWeight="Medium"/>
            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
            <DataGridTextColumn Header="Info"     Binding="{Binding RootId}"   Width="*"
                                FontSize="11"/>
          </DataGrid.Columns>
        </DataGrid>

        <!-- Empty state -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                    IsVisible="{Binding !IsBusy}">
          <material:MaterialIcon Kind="DatabaseSearch" Width="52" Height="52"
                                 Foreground="{StaticResource TextMuted}"
                                 IsVisible="{Binding SearchResults.Count,
                                             Converter={x:Static ObjectConverters.IsNull}}"/>
          <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="400"
                     TextAlignment="Center" FontSize="13"
                     Foreground="{StaticResource TextMuted}"
                     IsVisible="{Binding SearchResults.Count,
                                 Converter={x:Static ObjectConverters.IsNull}}"
                     Text="Search by item name or enter a root ID directly&#10;Click a result to see its game files"/>
        </StackPanel>
      </Grid>

      <!-- ── File list ── -->
      <Grid IsVisible="{Binding !ShowResults}" RowDefinitions="*">
        <DataGrid ItemsSource="{Binding Files}"
                  SelectedItem="{Binding SelectedFile}"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  CanUserResizeColumns="True"
                  Background="{StaticResource BgBase}"
                  RowBackground="{StaticResource BgBase}"
                  BorderThickness="0">
          <DataGrid.Columns>
            <DataGridTextColumn Header="File Name" Binding="{Binding FileName}"  Width="*"  FontWeight="Medium"/>
            <DataGridTextColumn Header="Type"      Binding="{Binding Extension}" Width="60"/>
            <DataGridTextColumn Header="Full Path" Binding="{Binding GamePath}"  Width="2*" FontSize="11"/>
          </DataGrid.Columns>
        </DataGrid>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                    IsVisible="{Binding !IsBusy}">
          <material:MaterialIcon Kind="FileSearch" Width="52" Height="52"
                                 Foreground="{StaticResource TextMuted}"
                                 IsVisible="{Binding Files.Count,
                                             Converter={x:Static ObjectConverters.IsNull}}"/>
          <TextBlock Text="No files found for this item" FontSize="13"
                     Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"
                     IsVisible="{Binding Files.Count,
                                 Converter={x:Static ObjectConverters.IsNull}}"/>
        </StackPanel>
      </Grid>

      <!-- Busy overlay -->
      <Border IsVisible="{Binding IsBusy}" Background="#CC000000">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <ProgressBar IsIndeterminate="True" Width="200"/>
          <TextBlock Text="Working..." Foreground="{StaticResource TextSecondary}"
                     HorizontalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- File action bar -->
    <Border Grid.Row="3"
            IsVisible="{Binding SelectedFile, Converter={x:Static ObjectConverters.IsNotNull}}"
            Background="{StaticResource BgCard}"
            BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,1,0,0"
            Padding="24,10">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
        <material:MaterialIcon Grid.Column="0" Kind="FileOutline"
                               Width="18" Height="18" Margin="0,0,10,0"
                               Foreground="{StaticResource AccentBlue}"
                               VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Spacing="1">
          <TextBlock FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"
                     Text="{Binding SelectedFile.FileName}"/>
          <TextBlock FontSize="10" Foreground="{StaticResource TextMuted}"
                     Text="{Binding SelectedFile.Directory}"/>
        </StackPanel>
        <Button Grid.Column="2" Classes="btn" Margin="8,0,4,0"
                Command="{Binding CopyPathCommand}" Content="Copy Path"/>
        <!-- Open in Texture Viewer (only for .tex files) -->
        <Button Grid.Column="3" Classes="btn" Margin="0,0,4,0"
                Command="{Binding OpenInTextureViewerCommand}"
                IsVisible="{Binding SelectedFile.Extension, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                IsEnabled="{Binding !IsBusy}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <material:MaterialIcon Kind="Image" Width="14" Height="14"/>
            <TextBlock Text="Open in Viewer"/>
          </StackPanel>
        </Button>
        <!-- Open in Material Editor (only for .mtrl files) -->
        <Button Grid.Column="4" Classes="btn" Margin="0,0,4,0"
                Command="{Binding OpenInMaterialEditorCommand}"
                IsVisible="{Binding SelectedFile.Extension, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                IsEnabled="{Binding !IsBusy}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <material:MaterialIcon Kind="Palette" Width="14" Height="14"/>
            <TextBlock Text="Open in Editor"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="5" Classes="btn-primary" IsEnabled="{Binding !IsBusy}"
                Command="{Binding ExtractFileCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <material:MaterialIcon Kind="Download" Width="14" Height="14"/>
            <TextBlock Text="Extract"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</UserControl>
